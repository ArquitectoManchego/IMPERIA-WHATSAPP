# Copia únicamente las variables faltantes a .env.local. No reemplaces valores existentes.
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CONTACTS_OWNER_EMAIL=
CRM_ALLOWED_EMAILS=
# Archivo JSON local de cuenta de servicio; nunca incluirlo en Git ni NEXT_PUBLIC_*.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/firebase-service-account.json
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
OPENWA_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=imperia-session
OPENWA_WEBHOOK_URL=http://127.0.0.1:3010/api/webhooks/openwa
WEBHOOK_SECRET=
CRM_WORKER_SECRET=
CRM_AUTOMATIONS_ENABLED=false
CRM_FOLLOWUP_DAYS=7
# Teléfono de pruebas autorizado (E.164, ej. +522291234567). Si CRM_AUTOMATIONS_ENABLED=false, solo se permite enviar a este número:
CRM_TEST_PHONE=
